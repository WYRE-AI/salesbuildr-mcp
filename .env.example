# Single-tenant credentials (stdio, and HTTP only when AUTH_MODE=env).
# The gateway compose service does not load these. Do not add them to that
# service's environment or via env_file.
SALESBUILDR_API_KEY=
# Optional tenant base URL. Not a credential.
# SALESBUILDR_BASE_URL=

# stdio (default) or http
MCP_TRANSPORT=stdio

# gateway: X-SalesBuildr-API-Key on each /mcp request.
#          Never falls back to SALESBUILDR_*.
# env:     use SALESBUILDR_* after X-Gateway-S2S verifies.
# AUTH_MODE=env

# Required to start the HTTP transport. The process logs an error and exits
# non-zero when this is empty or a known placeholder (changeme, your-secret,
# placeholder, ...), so a copied example cannot sign X-Gateway-S2S.
# Generate one with: openssl rand -hex 32
# Never commit a real secret. The value is never logged.
CONDUIT_S2S_SECRET=

# Local development only. Set to exactly 1 to start HTTP without
# CONDUIT_S2S_SECRET. The server logs a warning, does not check X-Gateway-S2S,
# and binds 127.0.0.1 only. A non-loopback MCP_HTTP_HOST refuses to start.
# A known placeholder secret is still refused.
# MCP_ALLOW_INSECURE_DEV=1

# Bind address when a real CONDUIT_S2S_SECRET is set. Unset keeps 0.0.0.0
# so container deploys are unchanged. The image sets MCP_HTTP_HOST=0.0.0.0.
# Without a secret, MCP_ALLOW_INSECURE_DEV=1 ignores this and binds 127.0.0.1.
# MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8080

LOG_LEVEL=info
